        "cluster_id": "e427b356-e1f7-4933-9525-3c454074236f",
        "title_ko": "설화수, 일본 럭셔리 시장 정조준",
        "summary_ko": "아모레퍼시픽의 설화수가 일본 최대 뷰티 플랫폼 @cosme TOKYO를 거점으로 체험형 마케팅을 강화하고 있다. K-뷰티를 저가 대중 브랜드가 아닌 럭셔리 카테고리로 재정의하려는 전략으로, 일본 프리미엄 시장 공략의 실험대로 주목된다.",
        "is_paywalled": false
      }
